---
// EventCard — typographic signage style, no heavy image background
interface Props {
  day: string;
  band: string;
  description: string;
  time: string;
  image: string;
}

const { day, band, description, time } = Astro.props;
---

<article class="event-card reveal">
  <div class="event-card__day">{day}</div>
  <div class="event-card__body">
    <p class="event-card__time">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <circle cx="12" cy="12" r="10"/>
        <polyline points="12 6 12 12 16 14"/>
      </svg>
      {time}
    </p>
    <h3 class="event-card__band">{band}</h3>
    <p class="event-card__desc">{description}</p>
  </div>
</article>

<style>
  .event-card {
    padding: 2rem 1.75rem;
    border-left: 2px solid var(--color-brown);
    background-color: var(--color-dark);
    transition: border-color var(--transition-base), background-color var(--transition-base);
    cursor: default;
  }

  .event-card:hover {
    border-left-color: var(--color-gold);
    background-color: rgba(45, 31, 21, 0.4);
  }

  .event-card__day {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 300;
    color: var(--color-gold);
    line-height: 1;
    margin-bottom: 1.25rem;
  }

  .event-card__body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .event-card__time {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-body);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .event-card__band {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 600;
    color: var(--color-text-primary);
    line-height: 1.2;
  }

  .event-card__desc {
    font-family: var(--font-body);
    font-size: 0.82rem;
    line-height: 1.6;
    color: var(--color-text-muted);
  }
</style>
