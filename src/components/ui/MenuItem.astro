---
// MenuItem — compact row: optional thumbnail + name + description. No price.
interface Props {
  name: string;
  description?: string;
  image?: string;
}

const { name, description, image } = Astro.props;
---

<article class="menu-item">
  <div class="menu-item__body">
    <h3 class="menu-item__name">{name}</h3>
    {description && <p class="menu-item__desc">{description}</p>}
  </div>
  {image && (
    <div class="menu-item__thumb">
      <img src={image} alt={name} loading="lazy" width="72" height="72" />
    </div>
  )}
</article>

<style>
  .menu-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    padding: 0.95rem 0;
    border-bottom: 1px solid rgba(200, 184, 154, 0.45);
  }

  .menu-item:last-child {
    border-bottom: none;
  }

  /* Thumbnail */
  .menu-item__thumb {
    flex-shrink: 0;
    width: 84px;
    height: 84px;
    overflow: hidden;
    border-radius: 3px;
    background-color: rgba(200, 184, 154, 0.25);
  }

  .menu-item__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--transition-base);
  }

  .menu-item:hover .menu-item__thumb img {
    transform: scale(1.08);
  }

  /* Body */
  .menu-item__body {
    min-width: 0;
    flex: 1;
  }

  .menu-item__name {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 600;
    line-height: 1.25;
    color: var(--color-text-dark);
    margin: 0;
  }

  .menu-item__desc {
    font-family: var(--font-body);
    font-size: 0.88rem;
    line-height: 1.55;
    color: #6d6153;
    margin: 0.3rem 0 0;
  }

  @media (max-width: 480px) {
    .menu-item__thumb {
      width: 64px;
      height: 64px;
    }

    .menu-item__name {
      font-size: 1.1rem;
    }

    .menu-item__desc {
      font-size: 0.82rem;
    }
  }
</style>
