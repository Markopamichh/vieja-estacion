---
// Header — transparent on top, dark on scroll, full-screen mobile overlay
---

<header class="site-header" id="site-header">
  <nav class="site-nav container">
    <a href="/#inicio" class="site-nav__logo">La Vieja Estación</a>

    <ul class="site-nav__links">
      <li><a href="/#inicio">Inicio</a></li>
      <li><a href="/#menu">Menú</a></li>
      <li><a href="/#eventos">Eventos</a></li>
      <li><a href="/#historia">Historia</a></li>
      <li><a href="/#reservas" class="site-nav__reservas">Reservas</a></li>
    </ul>

    <button class="site-nav__burger" id="burger" aria-label="Abrir menú" aria-expanded="false">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
        <line x1="3" y1="6" x2="21" y2="6" class="burger-line burger-line--1"/>
        <line x1="3" y1="12" x2="21" y2="12" class="burger-line burger-line--2"/>
        <line x1="3" y1="18" x2="21" y2="18" class="burger-line burger-line--3"/>
      </svg>
    </button>
  </nav>

  <!-- Mobile overlay -->
  <div class="mobile-overlay" id="mobile-overlay">
    <button class="mobile-overlay__close" id="overlay-close" aria-label="Cerrar menú">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
        <line x1="4" y1="4" x2="20" y2="20"/>
        <line x1="20" y1="4" x2="4" y2="20"/>
      </svg>
    </button>
    <ul class="mobile-overlay__links">
      <li><a href="/#inicio">Inicio</a></li>
      <li><a href="/#menu">Menú</a></li>
      <li><a href="/#eventos">Eventos</a></li>
      <li><a href="/#historia">Historia</a></li>
      <li><a href="/#reservas">Reservas</a></li>
    </ul>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    transition: background-color 0.4s ease, backdrop-filter 0.4s ease;
  }

  .site-header.scrolled {
    background-color: var(--color-dark);
    border-bottom: 1px solid var(--color-brown);
  }

  .site-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 4.5rem;
  }

  /* Logo */
  .site-nav__logo {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.25rem;
    font-weight: 400;
    color: var(--color-text-primary);
    letter-spacing: 0.02em;
    flex-shrink: 0;
  }

  /* Desktop links */
  .site-nav__links {
    display: flex;
    gap: 2.5rem;
    align-items: center;
  }

  .site-nav__links a {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-text-primary);
    transition: color var(--transition-base);
    position: relative;
  }

  .site-nav__links a::after {
    content: '';
    position: absolute;
    bottom: -3px;
    left: 0;
    width: 0;
    height: 1px;
    background-color: var(--color-gold);
    transition: width var(--transition-base);
  }

  .site-nav__links a:hover {
    color: var(--color-gold);
  }

  .site-nav__links a:hover::after {
    width: 100%;
  }

  .site-nav__reservas {
    color: var(--color-gold) !important;
  }

  /* Burger */
  .site-nav__burger {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--color-text-primary);
    padding: 0.25rem;
  }

  /* Mobile overlay */
  .mobile-overlay {
    position: fixed;
    inset: 0;
    background-color: var(--color-dark);
    z-index: 200;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.4s ease, visibility 0.4s ease;
  }

  .mobile-overlay.open {
    opacity: 1;
    visibility: visible;
  }

  .mobile-overlay__close {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--color-text-muted);
    padding: 0.5rem;
    transition: color var(--transition-base);
  }

  .mobile-overlay__close:hover {
    color: var(--color-text-primary);
  }

  .mobile-overlay__links {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
  }

  .mobile-overlay__links a {
    font-family: var(--font-display);
    font-size: clamp(2rem, 7vw, 2.75rem);
    font-weight: 300;
    color: var(--color-text-primary);
    letter-spacing: 0.03em;
    transition: color var(--transition-base);
  }

  .mobile-overlay__links a:hover {
    color: var(--color-gold);
  }

  /* Mobile breakpoint */
  @media (max-width: 768px) {
    .site-nav__links {
      display: none;
    }
    .site-nav__burger {
      display: block;
    }
  }
</style>
