---
// Footer — logo, nav links, contact info, social, credits
const facebookUrl = import.meta.env.PUBLIC_FACEBOOK_URL || 'https://www.facebook.com/barculturalVIEJAESTACION';
const instagramUrl = import.meta.env.PUBLIC_INSTAGRAM_URL || 'https://www.instagram.com/laviejabarcultural/';
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer__main container">
    <!-- Brand column -->
    <div class="footer__brand">
      <a href="/#inicio" class="footer__logo-link">
        <img src="/assets/images/logoimg.png" alt="La Vieja Estación" class="footer__logo" width="72" height="72" loading="lazy" />
      </a>
      <p class="footer__brand-name">La Vieja Estación</p>
      <p class="footer__tagline">Bar cultural con música en vivo en el corazón de Centenario, Neuquén.</p>
      <div class="footer__social">
        <a href={instagramUrl} target="_blank" rel="noopener noreferrer" aria-label="Instagram">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
          </svg>
        </a>
        <a href={facebookUrl} target="_blank" rel="noopener noreferrer" aria-label="Facebook">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
          </svg>
        </a>
        <a href="https://wa.me/542994051816?text=Buenas%2C%20me%20gustar%C3%ADa%20una%20reserva" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
        </a>
      </div>
    </div>

    <!-- Nav links -->
    <div class="footer__nav">
      <h4 class="footer__heading">Navegación</h4>
      <ul class="footer__links">
        <li><a href="/#inicio">Inicio</a></li>
        <li><a href="/#menu">Menú</a></li>
        <li><a href="/#eventos">Eventos</a></li>
        <li><a href="/#historia">Historia</a></li>
        <li><a href="/#ubicacion">Ubicación</a></li>
        <li><a href="/#reservas">Reservas</a></li>
      </ul>
    </div>

    <!-- Contact info -->
    <div class="footer__contact">
      <h4 class="footer__heading">Contacto</h4>
      <ul class="footer__links">
        <li>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>
          </svg>
          <span>Av. Gral. Belgrano 195, Centenario</span>
        </li>
        <li>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
          </svg>
          <span>Mié, Jue y Dom · 19:00 – 01:00<br />Vie y Sáb · 19:00 – 04:00</span>
        </li>
        <li>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.12.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.58 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
          <span>+54 299 405-1816</span>
        </li>
      </ul>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="footer__bottom container">
    <p>&copy; {currentYear} La Vieja Estación. Todos los derechos reservados. <a href="/privacidad" class="footer__legal-link">Política de Privacidad</a></p>
    <p class="footer__credit">Designed & developed by <a href="https://portfoliomarko.vercel.app/" target="_blank" rel="noopener noreferrer">Marko Pamich</a></p>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-dark);
    border-top: 1px solid var(--color-brown);
    padding-top: 4.5rem;
    padding-bottom: 2rem;
  }

  /* ── Main grid ── */
  .footer__main {
    display: grid;
    grid-template-columns: 1.1fr 1fr 1.15fr;
    gap: 4.5rem;
    padding-bottom: 3.5rem;
    border-bottom: 1px solid var(--color-brown);
  }

  /* ── Brand column ── */
  .footer__brand {
    display: flex;
    flex-direction: column;
  }

  .footer__logo-link {
    display: inline-block;
    width: fit-content;
    margin-bottom: 1.25rem;
  }

  .footer__logo {
    width: 72px;
    height: 72px;
    object-fit: cover;
    border-radius: 50%;
    border: 2px solid var(--color-gold);
    box-shadow: 0 0 0 4px rgba(201, 169, 110, 0.15);
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }

  .footer__logo-link:hover .footer__logo {
    transform: scale(1.05);
    box-shadow: 0 0 0 6px rgba(201, 169, 110, 0.25);
  }

  .footer__brand-name {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.35rem;
    font-weight: 400;
    color: var(--color-text-primary);
    margin-bottom: 0.5rem;
  }

  .footer__tagline {
    font-family: var(--font-body);
    font-size: 0.85rem;
    color: var(--color-text-muted);
    line-height: 1.7;
    max-width: 340px;
    margin-bottom: 1.5rem;
  }

  .footer__social {
    display: flex;
    gap: 0.75rem;
  }

  .footer__social a {
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    border: 1px solid var(--color-brown);
    color: var(--color-text-muted);
    transition: all var(--transition-base);
  }

  .footer__social a:hover {
    color: var(--color-gold);
    border-color: var(--color-gold);
    background: rgba(201, 169, 110, 0.08);
    transform: translateY(-2px);
  }

  /* ── Column headings ── */
  .footer__heading {
    font-family: var(--font-body);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-gold);
    margin-bottom: 1.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-brown);
  }

  /* ── Links ── */
  .footer__links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .footer__nav .footer__links a {
    font-family: var(--font-body);
    font-size: 0.85rem;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--transition-base), padding-left var(--transition-base);
    display: inline-block;
  }

  .footer__nav .footer__links a:hover {
    color: var(--color-text-primary);
    padding-left: 4px;
  }

  /* ── Contact ── */
  .footer__contact .footer__links li {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    font-family: var(--font-body);
    font-size: 0.85rem;
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  .footer__contact .footer__links svg {
    color: var(--color-gold-muted);
    flex-shrink: 0;
    margin-top: 2px;
  }

  /* ── Bottom bar ── */
  .footer__bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 1.75rem;
    margin-top: 0;
  }

  .footer__bottom p {
    font-family: var(--font-body);
    font-size: 0.72rem;
    color: var(--color-text-muted);
    letter-spacing: 0.05em;
  }

  .footer__legal-link {
    color: var(--color-gold-muted);
    text-decoration: none;
    transition: color var(--transition-base);
  }

  .footer__legal-link:hover {
    color: var(--color-gold);
  }

  .footer__credit a {
    color: var(--color-gold-muted);
    text-decoration: none;
    transition: color var(--transition-base);
  }

  .footer__credit a:hover {
    color: var(--color-gold);
  }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .site-footer {
      padding-top: 3.5rem;
    }

    .footer__main {
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
    }

    .footer__brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 480px) {
    .site-footer {
      padding-top: 3rem;
    }

    .footer__main {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .footer__bottom {
      flex-direction: column;
      gap: 0.6rem;
      text-align: center;
    }
  }
</style>
