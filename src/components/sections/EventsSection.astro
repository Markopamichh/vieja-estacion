---
// Eventos — CTA a Instagram con la agenda vigente
const INSTAGRAM_URL = 'https://www.instagram.com/laviejabarcultural/';
---

<section id="eventos" class="events section--dark">
  <div class="container">
    <div class="events__header reveal">
      <p class="section-label">Agenda</p>
      <h2 class="section-title events__title">Eventos</h2>
    </div>

    <a
      href={INSTAGRAM_URL}
      target="_blank"
      rel="noopener noreferrer"
      class="events__card reveal"
      aria-label="Seguir a La Vieja Estación en Instagram y ver la agenda"
    >
      <div class="events__card-media">
        <img
          src="/assets/images/events/711814479_18445589335136104_5057417060588872750_n.jpg"
          alt="Música en vivo en La Vieja Estación"
          loading="lazy"
        />
        <div class="events__card-shade"></div>
      </div>

      <div class="events__card-content">
        <span class="events__card-tag">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
          </svg>
          @laviejabarcultural
        </span>

        <h3 class="events__card-title">La agenda se vive en Instagram</h3>

        <p class="events__card-text">
          Cada semana anunciamos shows y eventos increibles. 
          Seguinos para enterarte de los próximos eventos y no perderte ninguno.
        </p>

        <span class="events__card-btn">Ver próximos eventos en Instagram →</span>
      </div>
    </a>
  </div>
</section>

<style>
  .events {
    padding-block: var(--section-pad);
  }

  .events__header {
    margin-bottom: 3.5rem;
  }

  .events__title {
    color: var(--color-text-primary);
    margin-top: 0.5rem;
  }

  .events__card {
    position: relative;
    display: block;
    overflow: hidden;
    border: 1px solid var(--color-brown);
    background-color: var(--color-dark-mid);
    transition: border-color var(--transition-base), transform var(--transition-base);
  }

  .events__card:hover {
    border-color: var(--color-gold);
    transform: translateY(-4px);
  }

  .events__card-media {
    position: absolute;
    inset: 0;
  }

  .events__card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.5);
    transition: transform 0.6s ease, filter 0.5s ease;
  }

  .events__card-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(26, 20, 16, 0.96) 0%,
      rgba(26, 20, 16, 0.82) 45%,
      rgba(26, 20, 16, 0.45) 100%
    );
  }

  .events__card:hover .events__card-media img {
    transform: scale(1.05);
    filter: brightness(0.55);
  }

  .events__card-content {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    padding: clamp(2.5rem, 6vw, 4.5rem);
    max-width: 680px;
  }

  .events__card-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-gold);
    border: 1px solid rgba(201, 169, 110, 0.4);
    background: rgba(26, 20, 16, 0.35);
    padding: 0.5rem 0.9rem;
  }

  .events__card-title {
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 3.5vw, 2.8rem);
    font-weight: 400;
    font-style: italic;
    line-height: 1.15;
    color: var(--color-text-primary);
  }

  .events__card-text {
    font-family: var(--font-body);
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--color-text-muted);
    max-width: 560px;
  }

  .events__card-btn {
    display: inline-block;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.05rem;
    color: var(--color-gold);
    padding-bottom: 0.35rem;
    border-bottom: 1px solid var(--color-gold);
    transition: color var(--transition-base), border-color var(--transition-base);
  }

  .events__card:hover .events__card-btn {
    color: var(--color-text-primary);
    border-color: var(--color-text-primary);
  }
</style>