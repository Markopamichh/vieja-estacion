---
// Reservas — panel centrado con glow, CTA de WhatsApp y datos rápidos
---

<section id="reservas" class="reservas section--mid">
  <div class="container">
    <div class="reservas__panel reveal">
      <div class="reservas__glow" aria-hidden="true"></div>

      <p class="section-label reservas__label">¿Querés venir?</p>
      <h2 class="section-title reservas__title">Reservá tu mesa</h2>
      <p class="reservas__sub">
        Escribinos por WhatsApp y te confirmamos la disponibilidad en minutos.
        Sin formularios ni vueltas.
      </p>

      <a
        href="https://wa.me/542994051816?text=Buenas%2C%20me%20gustar%C3%ADa%20una%20reserva"
        class="reservas__btn"
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        Escribinos por WhatsApp
      </a>

      <div class="reservas__divider" aria-hidden="true"></div>

      <ul class="reservas__info">
        <li>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
          </svg>
          <span>Mié a Dom · desde las 19:00</span>
        </li>
        <li>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>
          </svg>
          <span>Av. Gral. Belgrano 195, Centenario</span>
        </li>
        <li>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.12.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.58 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
          <span>+54 299 405-1816</span>
        </li>
      </ul>
    </div>
  </div>
</section>

<style>
  .reservas {
    padding-block: var(--section-pad);
  }

  /* Panel centrado con borde y glow */
  .reservas__panel {
    position: relative;
    max-width: 640px;
    margin-inline: auto;
    text-align: center;
    padding: clamp(2.5rem, 6vw, 4.5rem) clamp(1.5rem, 5vw, 4rem);
    background: linear-gradient(180deg, rgba(61, 43, 31, 0.35) 0%, rgba(45, 31, 21, 0.2) 100%);
    border: 1px solid var(--color-brown);
    border-radius: 20px;
    overflow: hidden;
    isolation: isolate;
  }

  .reservas__glow {
    position: absolute;
    left: 50%;
    top: -30%;
    width: 70%;
    height: 320px;
    transform: translateX(-50%);
    background: radial-gradient(
      ellipse at center,
      rgba(201, 169, 110, 0.22) 0%,
      rgba(201, 169, 110, 0) 65%
    );
    z-index: -1;
    pointer-events: none;
  }

  .reservas__label {
    color: var(--color-gold);
  }

  .reservas__title {
    color: var(--color-text-primary);
    margin-top: 0.5rem;
    margin-bottom: 1.25rem;
  }

  .reservas__sub {
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--color-text-muted);
    line-height: 1.7;
    max-width: 42ch;
    margin-inline: auto;
    margin-bottom: 2.25rem;
  }

  /* Botón WhatsApp — píldora redondeada */
  .reservas__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    background-color: #25D366;
    color: #fff;
    font-family: var(--font-body);
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    padding: 1rem 2rem;
    border-radius: 999px;
    box-shadow: 0 8px 24px rgba(37, 211, 102, 0.28);
    transition: background-color var(--transition-base), transform var(--transition-base), box-shadow var(--transition-base);
  }

  .reservas__btn:hover {
    background-color: #1ebe5a;
    transform: translateY(-2px);
    box-shadow: 0 12px 32px rgba(37, 211, 102, 0.38);
  }

  /* Divisor sutil */
  .reservas__divider {
    width: 48px;
    height: 1px;
    margin: 2.5rem auto 1.75rem;
    background: var(--color-gold-muted);
    opacity: 0.5;
  }

  /* Datos rápidos */
  .reservas__info {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem 1.75rem;
  }

  .reservas__info li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-body);
    font-size: 0.82rem;
    color: var(--color-text-muted);
  }

  .reservas__info svg {
    color: var(--color-gold-muted);
    flex-shrink: 0;
  }

  @media (max-width: 480px) {
    .reservas__info {
      flex-direction: column;
      align-items: center;
      gap: 0.85rem;
    }
  }
</style>
