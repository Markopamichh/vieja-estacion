---
// Ubicación — Google Maps embed + location card
---

<section id="ubicacion" class="location">
  <div class="location__glow" aria-hidden="true"></div>
  <div class="container">
    <div class="location__header reveal">
      <p class="section-label">Encontranos</p>
      <h2 class="section-title location__title">Cómo llegar</h2>
    </div>

    <div class="location__content reveal">
      <div class="location__map">
        <iframe
          src="https://maps.google.com/maps?q=Av.+Gral.+Belgrano+195,+Q8309+Centenario,+Neuqu%C3%A9n,+Argentina&z=16&output=embed"
          width="100%"
          height="100%"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Ubicación de La Vieja Estación en Centenario, Neuquén"
        ></iframe>
      </div>

      <div class="location__card">
        <div class="location__card-header">
          <div class="location__icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
              <circle cx="12" cy="10" r="3"/>
            </svg>
          </div>
          <div>
            <h3 class="location__card-name">La Vieja Estación</h3>
            <p class="location__card-type">Bar Cultural</p>
          </div>
        </div>

        <div class="location__card-details">
          <div class="location__detail">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
              <circle cx="12" cy="10" r="3"/>
            </svg>
            <span>Av. Gral. Belgrano 195, Q8309 Centenario, Neuquén</span>
          </div>

          <div class="location__detail">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10"/>
              <polyline points="12 6 12 12 16 14"/>
            </svg>
            <span>Mié, Jue y Dom · 19:00 – 01:00<br />Vie y Sáb · 19:00 – 04:00</span>
          </div>

          <div class="location__detail">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
            <span>+54 299 405-1816</span>
          </div>
        </div>

        <a
          href="https://www.google.com/maps/search/?api=1&query=Av.+Gral.+Belgrano+195,+Q8309+Centenario,+Neuqu%C3%A9n,+Argentina"
          target="_blank"
          rel="noopener noreferrer"
          class="location__directions-btn"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polygon points="3 11 22 2 13 21 11 13 3 11"/>
          </svg>
          Cómo llegar
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  /* Fondo en gradiente: arranca en el marrón oscuro (igual que Reseñas
     arriba) y se difumina hacia el marrón más claro de Reservas abajo,
     sin línea de corte. */
  .location {
    position: relative;
    padding-block: var(--section-pad);
    background: linear-gradient(
      to bottom,
      var(--color-dark) 0%,
      var(--color-dark) 25%,
      var(--color-dark-mid) 100%
    );
    overflow: hidden;
    isolation: isolate;
  }

  .location__glow {
    position: absolute;
    left: 50%;
    top: 8%;
    width: 65%;
    height: 320px;
    transform: translateX(-50%);
    background: radial-gradient(
      ellipse at center,
      rgba(201, 169, 110, 0.16) 0%,
      rgba(201, 169, 110, 0) 65%
    );
    z-index: -1;
    pointer-events: none;
  }

  .location__header {
    margin-bottom: 3rem;
  }

  .location__title {
    color: var(--color-text-primary);
    margin-top: 0.5rem;
  }

  .location__content {
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: 0;
    border: 1px solid var(--color-brown);
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 20px 60px rgba(26, 20, 16, 0.4);
  }

  .location__map {
    aspect-ratio: 16/10;
    min-height: 400px;
  }

  .location__map iframe {
    width: 100%;
    height: 100%;
    display: block;
    filter: grayscale(0.3) contrast(1.05);
  }

  .location__card {
    background: var(--color-dark-mid);
    padding: 2.5rem 2rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 2rem;
  }

  .location__card-header {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .location__icon {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--color-gold);
    color: var(--color-dark);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .location__card-name {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--color-text-primary);
    margin: 0;
  }

  .location__card-type {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-gold);
    margin: 0.25rem 0 0;
  }

  .location__card-details {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .location__detail {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-body);
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }

  .location__detail svg {
    color: var(--color-gold-muted);
    flex-shrink: 0;
  }

  .location__directions-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.85rem 1.5rem;
    background: var(--color-gold);
    color: var(--color-dark);
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    border: none;
    cursor: pointer;
    transition: background var(--transition-base), transform var(--transition-base);
  }

  .location__directions-btn:hover {
    background: var(--color-gold-muted);
    transform: translateY(-1px);
  }

  @media (max-width: 900px) {
    .location__content {
      grid-template-columns: 1fr;
    }

    .location__map {
      min-height: 300px;
    }
  }

  @media (max-width: 480px) {
    .location__card {
      padding: 2rem 1.25rem;
    }

    .location__map {
      min-height: 250px;
    }
  }
</style>
