---
// Hero section — fullscreen, parallax bg, staggered fade-in text
---

<section id="inicio" class="hero">
  <div class="hero__bg"></div>
  <div class="hero__overlay"></div>
  <div class="hero__content">
    <p class="hero__location">Centenario, Neuquén</p>
    <h1 class="hero__title">La Vieja Estación</h1>
    <p class="hero__tagline">Bar &nbsp;·&nbsp; Música &nbsp;·&nbsp; Historia</p>
  </div>
  <a href="#menu" class="hero__scroll-hint" aria-label="Ver menú">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="6 9 12 15 18 9"/>
    </svg>
  </a>
</section>

<style>
  .hero {
    position: relative;
    height: 100dvh;
    min-height: 600px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  /* Background with parallax via background-attachment */
  .hero__bg {
    position: absolute;
    inset: -10%;
    background-image: url('/assets/images/hero/heroimg.webp');
    background-size: cover;
    background-position: center;
    background-attachment: fixed;
    z-index: 0;
  }

  /* Gradient overlay */
  .hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(26, 20, 16, 0.35) 0%,
      rgba(26, 20, 16, 0.65) 60%,
      rgba(26, 20, 16, 0.88) 100%
    );
    z-index: 1;
  }

  /* Content */
  .hero__content {
    position: relative;
    z-index: 2;
    text-align: center;
    padding-inline: 1.5rem;
  }

  .hero__location {
    font-family: var(--font-body);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--color-gold);
    margin-bottom: 1.25rem;
    opacity: 0; /* GSAP animates this in */
  }

  .hero__title {
    font-family: var(--font-display);
    font-size: clamp(3rem, 9vw, 7rem);
    font-weight: 300;
    letter-spacing: 0.04em;
    color: var(--color-text-primary);
    line-height: 1;
    margin-bottom: 1.5rem;
    opacity: 0; /* GSAP animates this in */
  }

  .hero__tagline {
    font-family: var(--font-body);
    font-size: clamp(0.7rem, 1.5vw, 0.85rem);
    font-weight: 400;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    opacity: 0; /* GSAP animates this in */
  }

  /* Scroll hint arrow */
  .hero__scroll-hint {
    position: absolute;
    bottom: 2.5rem;
    left: 50%;
    z-index: 2;
    color: var(--color-text-muted);
    animation: scrollBounce 2s ease-in-out infinite;
    transition: color var(--transition-base);
    opacity: 0; /* GSAP animates this in */
  }

  .hero__scroll-hint:hover {
    color: var(--color-gold);
  }

  /* Disable parallax on mobile (background-attachment: fixed doesn't work well) */
  @media (max-width: 768px) {
    .hero__bg {
      inset: 0;
      background-attachment: scroll;
    }
  }
</style>

<script>
  // Hero entrance animation — runs after GSAP loads (loaded in BaseLayout head)
  document.addEventListener('DOMContentLoaded', () => {
    if (typeof gsap === 'undefined') return;

    gsap.to('.hero__location', { opacity: 1, y: 0, duration: 0.8, delay: 0.3, ease: 'power2.out' });
    gsap.to('.hero__title',    { opacity: 1, y: 0, duration: 1,   delay: 0.6, ease: 'power2.out' });
    gsap.to('.hero__tagline',  { opacity: 1, y: 0, duration: 0.8, delay: 0.9, ease: 'power2.out' });
    gsap.to('.hero__scroll-hint', { opacity: 1, duration: 0.8, delay: 1.4, ease: 'power2.out' });
  });
</script>
