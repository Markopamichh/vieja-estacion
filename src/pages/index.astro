---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Hero from '../components/sections/Hero.astro';
import HistorySection from '../components/sections/HistorySection.astro';
import MenuSection from '../components/sections/MenuSection.astro';
import EventsSection from '../components/sections/EventsSection.astro';
import ReservationSection from '../components/sections/ReservationSection.astro';
import LocationSection from '../components/sections/LocationSection.astro';
import { restaurantSchema } from '../utils/schemas';

const pageTitle = 'Inicio';
const pageDescription = 'Bar cultural con música en vivo en el corazón de Centenario, Neuquén. Buena comida, cervezas artesanales y eventos musicales todas las semanas. Mié, Jue y Dom de 19:00 a 01:00 · Vie y Sáb de 19:00 a 04:00.';
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  schema={restaurantSchema}
>
  <Header />

  <main>
    <Hero />
    <EventsSection />
    <MenuSection />
    <HistorySection />
    <LocationSection />
    <ReservationSection />
  </main>

  <Footer />

  <script src="../scripts/mobile-nav.ts"></script>
  <script src="../scripts/animations.ts"></script>
</BaseLayout>
