---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Hero from '../components/sections/Hero.astro';
import HistorySection from '../components/sections/HistorySection.astro';
import MenuSection from '../components/sections/MenuSection.astro';
import EventsSection from '../components/sections/EventsSection.astro';
import ReservationSection from '../components/sections/ReservationSection.astro';
import LocationSection from '../components/sections/LocationSection.astro';
import ReviewsSection from '../components/sections/ReviewsSection.astro';
import { restaurantSchema } from '../utils/schemas';

export const prerender = true;

const pageTitle = 'La Vieja Estación — Bar y Música en Vivo, Centenario';
const pageDescription = 'La Vieja Estación: bar cultural con música en vivo en Centenario, Neuquén. Buena comida, cervezas artesanales y shows todas las semanas. Mié a Dom desde las 19 hs.';
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  schema={restaurantSchema}
  preloadImage="/assets/images/hero/heroimg.webp"
>
  <Header />

  <main>
    <Hero />
    <EventsSection />
    <MenuSection />
    <HistorySection />
    <ReviewsSection />
    <LocationSection />
    <ReservationSection />
  </main>

  <Footer />

  <script src="../scripts/mobile-nav.ts"></script>
  <script src="../scripts/animations.ts"></script>
</BaseLayout>
