---
// Menu section — warm cream background, typographic category separators
import { getCollection } from 'astro:content';
import MenuItem from '../ui/MenuItem.astro';

const allMenuItems = await getCollection('menu');
const categories = ['Entradas', 'Principales', 'Para Compartir'];
---

<section id="menu" class="menu-section section--light">
  <div class="container">
    <div class="menu-section__header reveal">
      <p class="section-label">Lo que servimos</p>
      <h2 class="section-title">Nuestro Menú</h2>
    </div>

    {categories.map(category => {
      const items = allMenuItems.filter(item =>
        item.data.category === category && item.data.active
      );
      if (items.length === 0) return null;

      return (
        <div class="menu-category">
          <div class="menu-category__sep reveal">
            <span>{category.toUpperCase()}</span>
          </div>
          <div class="menu-category__grid">
            {items.map(item => (
              <MenuItem {...item.data} />
            ))}
          </div>
        </div>
      );
    })}
  </div>
</section>

<style>
  .menu-section {
    padding-block: var(--section-pad);
  }

  .menu-section__header {
    margin-bottom: 4rem;
  }

  .menu-section .section-label {
    color: var(--color-gold-muted);
  }

  .menu-section .section-title {
    color: var(--color-text-dark);
    margin-top: 0.5rem;
  }

  /* Category separator */
  .menu-category {
    margin-bottom: 3.5rem;
  }

  .menu-category__sep {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .menu-category__sep span {
    font-family: var(--font-body);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.25em;
    color: var(--color-text-dark);
    flex-shrink: 0;
  }

  .menu-category__sep::after {
    content: '';
    flex: 1;
    height: 1px;
    background-color: #c8b89a;
  }

  /* Grid */
  .menu-category__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  @media (max-width: 480px) {
    .menu-category__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
