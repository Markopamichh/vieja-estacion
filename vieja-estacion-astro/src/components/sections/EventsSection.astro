---
// Música en Vivo — dark section, typographic event cards + Instagram placeholder
import { getCollection } from 'astro:content';
import EventCard from '../ui/EventCard.astro';

const allEvents = await getCollection('events');
const activeEvents = allEvents
  .filter(event => event.data.active)
  .sort((a, b) => a.data.eventDate.getTime() - b.data.eventDate.getTime());
---

<section id="musica" class="music section--dark">
  <div class="container">
    <div class="music__header reveal">
      <p class="section-label">Cada semana</p>
      <h2 class="section-title music__title">Música en Vivo</h2>
    </div>

    <div class="events-grid">
      {activeEvents.map(event => (
        <EventCard {...event.data} />
      ))}
    </div>

    <!-- Instagram placeholder -->
    <div class="ig-section reveal">
      <div class="ig-section__top">
        <p class="ig-section__label">Seguinos en Instagram</p>
        <a
          href="https://www.instagram.com/laviejabarcultural/"
          target="_blank"
          rel="noopener noreferrer"
          class="ig-section__handle"
        >@laviejabarcultural</a>
      </div>
      <div class="ig-grid">
        <div class="ig-post">
          <img src="/assets/images/events/musicaenvivo2.jpeg" alt="Post Instagram" loading="lazy">
          <div class="ig-post__caption">Viernes de rock en vivo — el escenario nos espera</div>
        </div>
        <div class="ig-post">
          <img src="/assets/images/events/musicaenvivo4.jpeg" alt="Post Instagram" loading="lazy">
          <div class="ig-post__caption">Jazz Quartet — miércoles íntimo con el mejor sonido</div>
        </div>
        <div class="ig-post">
          <img src="/assets/images/events/musicaenvivo6.jpeg" alt="Post Instagram" loading="lazy">
          <div class="ig-post__caption">Domingo Sunset Sessions — música al caer el sol</div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .music {
    padding-block: var(--section-pad);
  }

  .music__header {
    margin-bottom: 4rem;
  }

  .music__title {
    color: var(--color-text-primary);
    margin-top: 0.5rem;
  }

  /* Events grid */
  .events-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1px;
    border: 1px solid var(--color-brown);
    margin-bottom: 5rem;
  }

  /* Instagram section */
  .ig-section__top {
    display: flex;
    align-items: baseline;
    gap: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .ig-section__label {
    font-family: var(--font-body);
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .ig-section__handle {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.1rem;
    color: var(--color-gold);
    transition: color var(--transition-base);
  }

  .ig-section__handle:hover {
    color: var(--color-text-primary);
  }

  /* IG grid */
  .ig-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 6px;
  }

  .ig-post {
    position: relative;
    aspect-ratio: 1/1;
    overflow: hidden;
    border: 1px solid var(--color-brown);
  }

  .ig-post img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease, filter 0.4s ease;
  }

  .ig-post__caption {
    position: absolute;
    inset: 0;
    background-color: rgba(26, 20, 16, 0.88);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.25rem;
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-style: italic;
    font-weight: 300;
    color: var(--color-text-primary);
    text-align: center;
    line-height: 1.5;
    opacity: 0;
    transition: opacity 0.35s ease;
  }

  .ig-post:hover img {
    transform: scale(1.06);
    filter: brightness(0.6);
  }

  .ig-post:hover .ig-post__caption {
    opacity: 1;
  }

  @media (max-width: 768px) {
    .events-grid {
      grid-template-columns: 1fr;
    }

    .ig-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 3px;
    }
  }

  @media (max-width: 480px) {
    .ig-grid {
      grid-template-columns: 1fr;
    }

    .ig-post {
      aspect-ratio: 4/3;
    }
  }
</style>
